            <!-- Checkboxes for days of the week -->
            <CheckBox
                android:id="@+id/cbL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_l"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_m"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_x"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbJ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_j"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_v"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_s"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/fragment_valve_config_d"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@null"
                android:layout_marginTop="8dp"
                android:drawableTop="@drawable/custom_checkbox"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:padding="4dp"
                android:visibility="invisible"
                android:text="@string/fragment_valve_config_all"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/cbD"
                app:layout_constraintTop_toTopOf="@id/rgFrequencyType"
                app:layout_constraintBottom_toBottomOf="@+id/rgFrequencyType"
                app:layout_constraintEnd_toEndOf="@id/cbD"/>

            <!-- Flow arranges them automatically -->
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flowDaysOfWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="invisible"
                app:constraint_referenced_ids="cbL,cbM,cbX,cbJ,cbV,cbS,cbD"
                app:flow_horizontalGap="4dp"
                app:flow_wrapMode="aligned"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rgFrequencyType" />

            <View
                android:id="@+id/view2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/light_blue_finish"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/flowDaysOfWeek" />

            <!-- Horario de riego -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fragment_valve_config_time"
                android:textColor="@color/light_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view2" />

            <ImageView
                android:id="@+id/btnPickTime"
                android:layout_width="35dp"
                android:layout_height="30dp"
                android:layout_marginTop="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_schedule"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTime"
                app:tint="@color/light_blue" />

            <TextView
                android:id="@+id/tvNewTime"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/fragment_valve_config_new_time"
                android:textColor="@color/light_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnPickTime" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:overScrollMode="never"
                app:layout_constraintBottom_toBottomOf="@+id/btnPickTime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnPickTime"
                app:layout_constraintTop_toTopOf="@id/btnPickTime"
                tools:itemCount="3"
                tools:listitem="@layout/item_time_chip" />

            <View
                android:id="@+id/view3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/light_blue_finish"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNewTime" />

            <!-- Duración del riego -->
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/fragment_valve_config_duration"
                android:textColor="@color/light_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view3" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:paddingBottom="4dp"
                app:layout_constraintBottom_toBottomOf="@id/tvDuration"
                app:layout_constraintStart_toEndOf="@+id/tvDuration"
                app:layout_constraintTop_toTopOf="@id/tvDuration">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_address_selector"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="2"
                    android:text="3"
                    android:textColor="@color/light_blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="@string/fragment_valve_config_minutes"
                android:textColor="@color/gray"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tilDuration"
                app:layout_constraintStart_toEndOf="@id/tilDuration"
                app:layout_constraintTop_toTopOf="@id/tilDuration" />

            <!-- Sección: Por Humedad -->
            <TextView
                android:id="@+id/tvHumMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/fragment_valve_config_min_hum"
                android:textColor="@color/light_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rgControlMode" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHumMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:value="45"
                android:valueFrom="0"
                android:valueTo="100"
                app:layout_constraintEnd_toStartOf="@id/tvHumMinVal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHumMin" />

            <TextView
                android:id="@+id/tvHumMinVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45%"
                android:textColor="@color/light_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/sliderHumMin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sliderHumMin" />

            <TextView
                android:id="@+id/tvHumMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fragment_valve_config_max_hum"
                android:textColor="@color/light_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sliderHumMin" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderHumMax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:value="80"
                android:valueFrom="0"
                android:valueTo="100"
                app:layout_constraintEnd_toStartOf="@id/tvHumMaxVal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHumMax" />

            <TextView
                android:id="@+id/tvHumMaxVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="@color/light_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/sliderHumMax"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sliderHumMax" />

            <!-- Helpers: Grupos para mostrar/ocultar -->
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupScheduled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:constraint_referenced_ids="tvFrequency,rgFrequencyType,tvTime, tvNewTime, btnPickTime, rvTimes, tvDuration,tilDuration, tvDurationLabel, view1, view2, view3 " />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupSensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="tvHumMin,sliderHumMin,tvHumMinVal,tvHumMax,sliderHumMax,tvHumMaxVal" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_background_selector"
        android:enabled="true"
        android:text="@string/fragment_valve_config_btn_save"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/includeProgressBar"
        layout="@layout/view_progress_overlay" />


</androidx.constraintlayout.widget.ConstraintLayout>